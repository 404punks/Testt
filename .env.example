# Runtime mode. Demo data is isolated and visibly labeled when true.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solana / Pump (validate current official values before production use)
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=
SOLANA_WS_URL=
PUMP_PROGRAM_ID=

# Persistence and queues
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fonsfamily
REDIS_URL=redis://localhost:6379

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Isolated signer. Never place a private key in this application.
SIGNER_SERVICE_URL=
SIGNER_PUBLIC_KEY=

# Optional indexed market data provider
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=
